<Window x:Class="PerfmonNG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PerfmonNG"
        Title="PerfmonNG"
        Width="1480"
        Height="800"
        MinWidth="980"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6F2"
        FontFamily="Segoe UI">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#E9EEE8" BorderBrush="#D5DDD5" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem x:Name="OpenMenuItem" Header="_Open..." Click="Open_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="26,22,26,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Performance timeline" FontSize="24" FontWeight="SemiBold" Foreground="#1B2922" />
                    <TextBlock x:Name="SourceText" Margin="0,5,0,0" Text="No file selected" FontSize="13" Foreground="#66746A" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Aggregate each" FontSize="12" Foreground="#536257" />
                    <ComboBox x:Name="AggregationSelector" Width="105" SelectionChanged="Aggregation_SelectionChanged" />
                    <TextBlock Margin="18,0,10,0" VerticalAlignment="Center" Text="Statistic" FontSize="12" Foreground="#536257" />
                    <ComboBox x:Name="StatisticSelector" Width="110" SelectionChanged="Statistic_SelectionChanged" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="22,0,22,8" Background="White" BorderBrush="#CCD5CC" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.23*" MinWidth="340" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="1*" MinWidth="480" />
                    </Grid.ColumnDefinitions>
                    <local:TimeSeriesPlot x:Name="Chart" Grid.Row="0" Grid.Column="0" SizeChanged="Chart_SizeChanged" />
                    <Grid Grid.Row="1" Grid.Column="0" Margin="82,0,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollBar x:Name="TimelineScrollBar" Grid.Column="0" Orientation="Horizontal" Minimum="0" SmallChange="1" ValueChanged="TimelineScrollBar_ValueChanged" IsEnabled="False" />
                        <TextBlock x:Name="VisibleRangeText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="#66746A" />
                    </Grid>
                    <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#D5DDD5" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Cursor="SizeWE" />
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="8,0,0,0" Padding="8" BorderBrush="#E1E7E0" BorderThickness="1,0,0,0" Background="#FAFBF9">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="Counters" FontSize="13" FontWeight="SemiBold" Foreground="#35443A" />
                            <DataGrid x:Name="CounterRows" AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserResizeRows="False"
                                      CanUserSortColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      IsReadOnly="False" RowHeaderWidth="0"
                                      SelectionMode="Single" SelectionUnit="FullRow" RowHeight="30">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Computer / counter" Width="2*" MinWidth="220" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" VerticalAlignment="Center">
                                                    <Button Width="18" Height="22" Padding="0" Content="{Binding Node.ExpandGlyph}" Tag="{Binding Node}" Click="CounterExpand_Click" IsEnabled="{Binding Node.HasChildren}" Background="Transparent" BorderThickness="0" FontSize="12" />
                                                    <CheckBox Width="22" VerticalAlignment="Center" IsThreeState="{Binding Node.HasChildren}" IsChecked="{Binding Node.IsChecked, Mode=OneWay}" Tag="{Binding Node}" Click="CounterCheck_Click" Focusable="True" />
                                                    <TextBlock Text="{Binding Node.Caption}" ToolTip="{Binding Node.Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" Foreground="#46544A" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Colour" Width="64" MinWidth="60" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="30" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Node.SeriesVisibility}"
                                                        Background="{Binding Node.Series.Brush}" BorderBrush="#728076" BorderThickness="1" CornerRadius="2" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Node.Unit}" Width="75" MinWidth="65" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Min" Binding="{Binding Node.Minimum, StringFormat={}{0:N2}}" Width="82" MinWidth="72" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Max" Binding="{Binding Node.Maximum, StringFormat={}{0:N2}}" Width="82" MinWidth="72" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Average" Binding="{Binding Node.Average, StringFormat={}{0:N2}}" Width="96" MinWidth="84" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Median" Binding="{Binding Node.Median, StringFormat={}{0:N2}}" Width="84" MinWidth="72" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Row="2" Padding="22,10" BorderBrush="#D5DDD5" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText" Text="Ready. Open a data file to begin." FontSize="12" Foreground="#5D6C61" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
