<Application x:Class="PerfmonNG.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DataTemplate x:Key="CounterColorSwatchTemplate">
            <Border Width="30" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{Binding ColourBrush}" BorderBrush="#728076" BorderThickness="1" CornerRadius="2" />
        </DataTemplate>
    </Application.Resources>
</Application>
